---
import '../styles/global.css';
import { content } from '../lib/content';
import { publicUrl } from '../lib/site-url';

const formatPrice = new Intl.NumberFormat('pt-BR', {
  style: 'currency',
  currency: 'BRL',
  maximumFractionDigits: 0,
});
const canonicalUrl = publicUrl(content.site.publicBaseUrl);
const social = content.social;
const vehicleName = `${content.vehicle.make} ${content.vehicle.model}${content.vehicle.version ? ` ${content.vehicle.version}` : ''}`;
const vehicleYears = `${content.vehicle.year.manufacture}/${content.vehicle.year.model}`;
const vehicleMileage = `${content.vehicle.mileageKm.toLocaleString('pt-BR')} km`;
const heroImage = content.hero.primaryImage;
const heroIsEnabled = content.hero.enabled && content.sections.some((section) => section.id === 'hero' && section.enabled);
const detailsAreEnabled = content.sections.some(
  (section) => section.id === 'vehicle-details' && section.enabled,
);
const whatsappIsEnabled =
  content.hero.showWhatsappButton && content.links.whatsapp.enabled && content.links.whatsapp.url;

const specifications = [
  { label: 'Ano/modelo', value: vehicleYears },
  { label: 'Quilometragem', value: vehicleMileage },
  { label: 'Versão', value: content.vehicle.version },
  { label: 'Motor', value: content.vehicle.engine },
  { label: 'Câmbio', value: content.vehicle.transmission },
  { label: 'Combustível', value: content.vehicle.fuel },
  { label: 'Cor', value: content.vehicle.color },
].filter((specification): specification is { label: string; value: string } => Boolean(specification.value));
---

<!doctype html>
<html lang={content.site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl} />
    {heroIsEnabled && heroImage && <link rel="preload" as="image" href={heroImage} />}
    <title>{content.site.defaultMetadata.title}</title>
    <meta name="description" content={content.site.defaultMetadata.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={social.title} />
    <meta property="og:description" content={social.description} />
    {social.image && <meta property="og:image" content={social.image} />}
    {social.image && social.imageAlt && <meta property="og:image:alt" content={social.imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={social.title} />
    <meta name="twitter:description" content={social.description} />
    {social.image && <meta name="twitter:image" content={social.image} />}
  </head>
  <body>
    <main>
      {heroIsEnabled && (
        <section class="hero-section" aria-labelledby="vehicle-title">
          <div class="container hero">
            {heroImage && (
              <figure class="hero__media">
                <img
                  src={heroImage}
                  alt={`${vehicleName} anunciado para venda`}
                  width="1672"
                  height="941"
                  loading="eager"
                  fetchpriority="high"
                />
              </figure>
            )}

            <div class="hero__content">
              <p class="eyebrow">Anúncio particular</p>
              <h1 id="vehicle-title" class="type-vehicle-title">{vehicleName}</h1>

              {content.hero.showPrice && (
                <p class="hero__price">{formatPrice.format(content.vehicle.price)}</p>
              )}

              <div class="hero__metadata" aria-label="Ano e quilometragem">
                {content.hero.showYear && <span>{vehicleYears}</span>}
                {content.hero.showMileage && <span>{vehicleMileage}</span>}
              </div>

              {content.hero.showLocation && (
                <p class="hero__location">
                  <span class="label">Localização</span>
                  {content.vehicle.location}
                </p>
              )}

              {whatsappIsEnabled && (
                <a class="button button--primary hero__action" href={content.links.whatsapp.url}>
                  Falar pelo WhatsApp <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        </section>
      )}

      {detailsAreEnabled && (
        <section class="section section--muted vehicle-details" aria-labelledby="details-heading">
          <div class="container">
            <div class="section__header section__header--compact">
              <p class="eyebrow">Informações essenciais</p>
              <h2 id="details-heading" class="type-section-title">Sobre o veículo</h2>
              <p>Os principais dados para uma avaliação rápida e clara.</p>
            </div>

            <dl class="spec-grid">
              {specifications.map((specification) => (
                <div class="spec-card">
                  <dt>{specification.label}</dt>
                  <dd>{specification.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )}
    </main>
  </body>
</html>
