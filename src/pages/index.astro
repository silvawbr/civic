---
import '../styles/global.css';
import { content } from '../lib/content';
import { publicUrl } from '../lib/site-url';

const formatPrice = new Intl.NumberFormat('pt-BR', {
  style: 'currency',
  currency: 'BRL',
  maximumFractionDigits: 0,
});
const canonicalUrl = publicUrl(content.site.publicBaseUrl);
const social = content.social;
const vehicleName = `${content.vehicle.make} ${content.vehicle.model}${content.vehicle.version ? ` ${content.vehicle.version}` : ''}`;
const vehicleYears = `${content.vehicle.year.manufacture}/${content.vehicle.year.model}`;
const vehicleMileage = `${content.vehicle.mileageKm.toLocaleString('pt-BR')} km`;
const heroImage = content.hero.primaryImage;
const heroIsEnabled = content.hero.enabled && content.sections.some((section) => section.id === 'hero' && section.enabled);
const detailsAreEnabled = content.sections.some(
  (section) => section.id === 'vehicle-details' && section.enabled,
);
const galleryImages = content.gallery.filter((image) => image.enabled);
const galleryIsEnabled =
  galleryImages.length > 0 && content.sections.some((section) => section.id === 'gallery' && section.enabled);
const maintenanceItems = content.maintenance.filter((item) => item.enabled);
const maintenanceIsEnabled =
  maintenanceItems.length > 0 && content.sections.some((section) => section.id === 'maintenance' && section.enabled);
const whatsappIsEnabled =
  content.hero.showWhatsappButton && content.links.whatsapp.enabled && content.links.whatsapp.url;
const configuredPersistentActions = [
  {
    id: 'olx',
    href: content.links.olx.enabled ? content.links.olx.url : null,
    label: 'Ver na OLX',
    shortLabel: 'OLX',
    variant: 'secondary',
  },
  {
    id: 'webmotors',
    href: content.links.webmotors.enabled ? content.links.webmotors.url : null,
    label: 'Ver na Webmotors',
    shortLabel: 'Webmotors',
    variant: 'secondary',
  },
  {
    id: 'whatsapp',
    href: content.links.whatsapp.enabled ? content.links.whatsapp.url : null,
    label: 'Falar pelo WhatsApp',
    shortLabel: 'WhatsApp',
    variant: 'primary',
  },
];
const persistentActions = configuredPersistentActions.filter(
  (action): action is (typeof configuredPersistentActions)[number] & { href: string } => Boolean(action.href),
);

const maintenanceDateFormatter = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
  timeZone: 'UTC',
});

const formatMaintenanceDate = (date: string | null) =>
  date ? maintenanceDateFormatter.format(new Date(`${date}T00:00:00Z`)) : null;

const formatMaintenanceMileage = (mileageKm: number | null) =>
  mileageKm === null ? null : `${mileageKm.toLocaleString('pt-BR')} km`;

const specifications = [
  { label: 'Ano/modelo', value: vehicleYears },
  { label: 'Quilometragem', value: vehicleMileage },
  { label: 'Versão', value: content.vehicle.version },
  { label: 'Motor', value: content.vehicle.engine },
  { label: 'Câmbio', value: content.vehicle.transmission },
  { label: 'Combustível', value: content.vehicle.fuel },
  { label: 'Cor', value: content.vehicle.color },
].filter((specification): specification is { label: string; value: string } => Boolean(specification.value));
---

<!doctype html>
<html lang={content.site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl} />
    {heroIsEnabled && heroImage && <link rel="preload" as="image" href={heroImage} />}
    <title>{content.site.defaultMetadata.title}</title>
    <meta name="description" content={content.site.defaultMetadata.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={social.title} />
    <meta property="og:description" content={social.description} />
    {social.image && <meta property="og:image" content={social.image} />}
    {social.image && social.imageAlt && <meta property="og:image:alt" content={social.imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={social.title} />
    <meta name="twitter:description" content={social.description} />
    {social.image && <meta name="twitter:image" content={social.image} />}
  </head>
  <body>
    <main class:list={{ 'page--with-persistent-actions': persistentActions.length > 0 }}>
      {heroIsEnabled && (
        <section class="hero-section" aria-labelledby="vehicle-title">
          <div class="container hero">
            {heroImage && (
              <figure class="hero__media">
                <img
                  src={heroImage}
                  alt={`${vehicleName} anunciado para venda`}
                  width="1672"
                  height="941"
                  loading="eager"
                  fetchpriority="high"
                />
              </figure>
            )}

            <div class="hero__content">
              <p class="eyebrow">Anúncio particular</p>
              <h1 id="vehicle-title" class="type-vehicle-title">{vehicleName}</h1>

              {content.hero.showPrice && (
                <p class="hero__price">{formatPrice.format(content.vehicle.price)}</p>
              )}

              <div class="hero__metadata" aria-label="Ano e quilometragem">
                {content.hero.showYear && <span>{vehicleYears}</span>}
                {content.hero.showMileage && <span>{vehicleMileage}</span>}
              </div>

              {content.hero.showLocation && (
                <p class="hero__location">
                  <span class="label">Localização</span>
                  {content.vehicle.location}
                </p>
              )}

              {whatsappIsEnabled && (
                <a class="button button--primary hero__action" href={content.links.whatsapp.url}>
                  Falar pelo WhatsApp <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        </section>
      )}

      {detailsAreEnabled && (
        <section class="section section--muted vehicle-details" aria-labelledby="details-heading">
          <div class="container">
            <div class="section__header section__header--compact">
              <p class="eyebrow">Informações essenciais</p>
              <h2 id="details-heading" class="type-section-title">Sobre o veículo</h2>
              <p>Os principais dados para uma avaliação rápida e clara.</p>
            </div>

            <dl class="spec-grid">
              {specifications.map((specification) => (
                <div class="spec-card">
                  <dt>{specification.label}</dt>
                  <dd>{specification.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )}

      {galleryIsEnabled && (
        <section class="section gallery-section" aria-labelledby="gallery-heading">
          <div class="container">
            <div class="section__header">
              <p class="eyebrow">Conheça o carro</p>
              <h2 id="gallery-heading" class="type-section-title">Fotos do veículo</h2>
              <p>Uma visão do exterior, do interior e do porta-malas.</p>
            </div>

            <div class="gallery__grid">
              {galleryImages.map((image, index) => (
                <figure class:list={['gallery__item', { 'gallery__item--featured': index === 0 }]}>
                  <a
                    class="gallery__link"
                    href={image.src}
                    data-gallery-trigger
                    data-gallery-index={index}
                    aria-haspopup="dialog"
                    aria-label={`Abrir foto: ${image.alt}`}
                  >
                    <img
                      src={image.src}
                      alt={image.alt}
                      width={image.width}
                      height={image.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </figure>
              ))}
            </div>
          </div>
        </section>
      )}

      {maintenanceIsEnabled && (
        <section class="section section--muted maintenance-section" aria-labelledby="maintenance-heading">
          <div class="container">
            <div class="section__header">
              <p class="eyebrow">Registros de cuidado</p>
              <h2 id="maintenance-heading" class="type-section-title">Cuidados e manutenções recentes</h2>
              <p>Alguns dos serviços e componentes recentes do veículo, com informações e registros quando disponíveis.</p>
            </div>

            <div class="maintenance-grid">
              {maintenanceItems.map((item) => {
                const metadata = [
                  { label: 'Data', value: formatMaintenanceDate(item.date) },
                  { label: 'Quilometragem', value: formatMaintenanceMileage(item.mileageKm) },
                ].filter((entry): entry is { label: string; value: string } => Boolean(entry.value));
                const evidenceAlt = item.imageAlt ?? item.title;

                return (
                  <article class="maintenance-card">
                    {item.images.length > 0 && (
                      <div class:list={['maintenance-card__media', { 'maintenance-card__media--multiple': item.images.length > 1 }]}>
                        {item.images.map((image, index) => (
                          <a
                            class="maintenance-card__image-link"
                            href={image}
                            target="_blank"
                            rel="noreferrer"
                            aria-label={`Abrir evidência: ${evidenceAlt}${item.images.length > 1 ? ` (${index + 1})` : ''}`}
                          >
                            <img
                              src={image}
                              alt={`${evidenceAlt}${item.images.length > 1 ? ` (${index + 1})` : ''}`}
                              loading="lazy"
                              decoding="async"
                            />
                          </a>
                        ))}
                      </div>
                    )}

                    <div class="maintenance-card__body">
                      <h3 class="maintenance-card__title">{item.title}</h3>

                      {metadata.length > 0 && (
                        <dl class="maintenance-card__metadata">
                          {metadata.map((entry) => (
                            <div>
                              <dt>{entry.label}</dt>
                              <dd>{entry.value}</dd>
                            </div>
                          ))}
                        </dl>
                      )}

                      {item.description && <p class="maintenance-card__description">{item.description}</p>}

                      {item.details.length > 0 && (
                        <ul class="maintenance-card__details">
                          {item.details.map((detail) => <li>{detail}</li>)}
                        </ul>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        </section>
      )}
    </main>

    {persistentActions.length > 0 && (
      <aside
        class:list={[
          'persistent-actions',
          `persistent-actions--count-${persistentActions.length}`,
          { 'persistent-actions--has-primary': persistentActions.some((action) => action.variant === 'primary') },
        ]}
        aria-label="Ações disponíveis"
      >
        <div class="persistent-actions__inner container">
          {persistentActions.map((action) => (
            <a
              class:list={['button', `button--${action.variant}`, 'persistent-actions__action']}
              href={action.href}
              target="_blank"
              rel="noopener noreferrer"
              data-action={action.id}
              aria-label={action.label}
            >
              <span class="persistent-actions__label persistent-actions__label--long" aria-hidden="true">
                {action.label}
              </span>
              <span class="persistent-actions__label persistent-actions__label--short" aria-hidden="true">
                {action.shortLabel}
              </span>
            </a>
          ))}
        </div>
      </aside>
    )}

    {galleryIsEnabled && (
      <dialog class="gallery-dialog" data-gallery-dialog aria-labelledby="gallery-dialog-title">
        <div class="gallery-dialog__surface">
          <div class="gallery-dialog__header">
            <p id="gallery-dialog-title" class="gallery-dialog__title">Visualização ampliada</p>
            <button class="button button--secondary gallery-dialog__close" type="button" data-gallery-close>
              Fechar
            </button>
          </div>

          <div class="gallery-dialog__media">
            <img data-gallery-dialog-image alt="" />
          </div>

          <div class="gallery-dialog__controls">
            <button class="button button--secondary" type="button" data-gallery-previous>
              Anterior
            </button>
            <span class="gallery-dialog__counter" data-gallery-counter aria-live="polite"></span>
            <button class="button button--secondary" type="button" data-gallery-next>
              Próxima
            </button>
          </div>
        </div>
      </dialog>
    )}
  </body>

  {galleryIsEnabled && (
    <script>
      const dialog = document.querySelector('[data-gallery-dialog]');
      const triggers = Array.from(document.querySelectorAll('[data-gallery-trigger]'));

      if (dialog instanceof HTMLDialogElement && triggers.length > 0 && typeof dialog.showModal === 'function') {
        const dialogImage = dialog.querySelector<HTMLImageElement>('[data-gallery-dialog-image]');
        const closeButton = dialog.querySelector<HTMLButtonElement>('[data-gallery-close]');
        const previousButton = dialog.querySelector<HTMLButtonElement>('[data-gallery-previous]');
        const nextButton = dialog.querySelector<HTMLButtonElement>('[data-gallery-next]');
        const counter = dialog.querySelector<HTMLElement>('[data-gallery-counter]');

        if (!dialogImage || !closeButton || !previousButton || !nextButton || !counter) {
          throw new Error('Gallery dialog controls are incomplete.');
        }

        let currentIndex = 0;
        let activeTrigger: HTMLAnchorElement | null = null;

        const updateDialog = (index: number) => {
          const trigger = triggers[index];
          const image = trigger?.querySelector('img');

          if (!(trigger instanceof HTMLAnchorElement) || !(image instanceof HTMLImageElement)) {
            return;
          }

          currentIndex = index;
          dialogImage.src = image.getAttribute('src') || trigger.href;
          dialogImage.alt = image.alt;
          counter.textContent = `${index + 1} / ${triggers.length}`;
          previousButton.disabled = index === 0;
          nextButton.disabled = index === triggers.length - 1;
        };

        triggers.forEach((trigger, index) => {
          trigger.addEventListener('click', (event) => {
            if (!(trigger instanceof HTMLAnchorElement)) {
              return;
            }

            event.preventDefault();
            activeTrigger = trigger;
            updateDialog(index);
            dialog.showModal();
            closeButton.focus();
          });
        });

        closeButton.addEventListener('click', () => dialog.close());
        previousButton.addEventListener('click', () => {
          if (currentIndex > 0) {
            updateDialog(currentIndex - 1);
          }
        });
        nextButton.addEventListener('click', () => {
          if (currentIndex < triggers.length - 1) {
            updateDialog(currentIndex + 1);
          }
        });

        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) {
            dialog.close();
          }
        });

        dialog.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft' && currentIndex > 0) {
            updateDialog(currentIndex - 1);
          }

          if (event.key === 'ArrowRight' && currentIndex < triggers.length - 1) {
            updateDialog(currentIndex + 1);
          }
        });

        dialog.addEventListener('close', () => {
          activeTrigger?.focus();
          activeTrigger = null;
        });
      }
    </script>
  )}
</html>
