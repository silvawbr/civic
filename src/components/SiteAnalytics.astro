---
import Analytics from '@vercel/analytics/astro';
---

<script>
  import { sanitizeAnalyticsEvent, trackConversion } from '../lib/analytics';

  window.webAnalyticsBeforeSend = sanitizeAnalyticsEvent;

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) {
      return;
    }

    const action = event.target.closest<HTMLElement>('[data-action]')?.dataset.action;

    if (action) {
      trackConversion(action);
    }
  });
</script>

<Analytics />
